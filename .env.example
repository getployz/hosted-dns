# Postgres (PlanetScale in production). Include sslmode=require for hosted databases.
DATABASE_URL=postgres://user:password@localhost:5432/hosted_dns
# Route 53 hosted zone for the apex, and the apex itself.
HOSTED_ZONE_ID=Z0000000000000000000
APEX_DOMAIN=example.com
# Standard AWS credentials for an IAM user limited to that zone.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional.
PORT=8080
MINTS_PER_HOUR=30
# Set when behind a proxy that overwrites this header with the client IP.
CLIENT_IP_HEADER=x-real-ip
RUST_LOG=info
# ACME account for wildcard certificates (Google Trust Services, bound with EAB).
# Production directory: https://dv.acme-v02.api.pki.goog/directory
# Staging directory:    https://dv.acme-v02.test-api.pki.goog/directory
ACME_DIRECTORY_URL=https://dv.acme-v02.test-api.pki.goog/directory
ACME_EAB_KID=
# base64url, as `gcloud publicca external-account-keys create` prints it.
ACME_EAB_HMAC_KEY=
